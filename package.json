{
  "name": "payment-verification",
  "version": "1.0.0",
  "description": "Zenith Bank transaction ingestion worker — Phase 1 tracer",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/worker.js",
    "dev": "tsx src/worker.ts",
    "migrate": "tsx src/db/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "google-auth-library": "11.0.2",
    "googleapis": "178.1.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "quoted-printable": "1.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "20.14.0",
    "@types/pg": "8.10.9",
    "@types/quoted-printable": "1.0.2",
    "tsx": "4.7.1",
    "typescript": "5.6.3",
    "vitest": "3.1.1"
  }
}
