# payment-verification — Phase 1 env vars
# Copy to .env and fill. Never commit .env

DATABASE_URL=postgresql://user:password@localhost:5432/payment_verification

# Gmail OAuth — personal refresh token (D-01)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional Workspace service account
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_DELEGATED_USER=

# Gmail push (users.watch -> Pub/Sub) — poll sweep runs regardless
GOOGLE_CLOUD_PROJECT=
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_SUBSCRIPTION=


# Comma-separated sender domains
ZENITH_SENDER_DOMAINS=zenithbank.com

# Alerting
ALERT_WEBHOOK_URL=

# Thresholds / scheduling
STALENESS_THRESHOLD_MINUTES=60
BUSINESS_HOURS_START=07:00
BUSINESS_HOURS_END=21:00
BUSINESS_HOURS_TIMEZONE=Africa/Lagos
POLL_INTERVAL_MINUTES=15

# Observability
LOG_LEVEL=info
